function(fivepocket_generated_paths variable directories)
    set(resolved)
    foreach(entry IN LISTS ${variable})
        file(REAL_PATH "${entry}" full BASE_DIRECTORY "${FIVEPOCKET_GAME_DIR}")
        cmake_path(IS_PREFIX FIVEPOCKET_GAME_DIR "${full}" NORMALIZE inside)
        if(NOT inside OR NOT EXISTS "${full}")
            message(FATAL_ERROR "${variable} contains a missing or external generated input: ${entry}")
        endif()
        if(directories)
            if(NOT IS_DIRECTORY "${full}")
                message(FATAL_ERROR "Generated include path is not a directory: ${entry}")
            endif()
        elseif(IS_DIRECTORY "${full}")
            message(FATAL_ERROR "Generated file is a directory: ${entry}")
        endif()
        list(APPEND resolved "${full}")
    endforeach()
    set(${variable} "${resolved}" PARENT_SCOPE)
endfunction()

macro(fivepocket_load_generated_inputs)
    if(NOT FIVEPOCKET_GAME_DIR)
        message(FATAL_ERROR "Set FIVEPOCKET_GAME_DIR to the private output of the owned-disc source generator.")
    endif()
    file(REAL_PATH "${FIVEPOCKET_GAME_DIR}" FIVEPOCKET_GAME_DIR)
    set(_game_manifest "${FIVEPOCKET_GAME_DIR}/build-inputs.cmake")
    if(NOT EXISTS "${_game_manifest}")
        message(FATAL_ERROR "Missing ${_game_manifest}; generate the game sources from your owned discs first.")
    endif()
    include("${_game_manifest}")
    if(NOT FIVEPOCKET_GENERATED_SOURCES OR NOT FIVEPOCKET_GENERATED_INCLUDE_DIRS)
        message(FATAL_ERROR "build-inputs.cmake must declare generated sources and include directories.")
    endif()
    fivepocket_generated_paths(FIVEPOCKET_GENERATED_SOURCES FALSE)
    fivepocket_generated_paths(FIVEPOCKET_GENERATED_INCLUDE_DIRS TRUE)
    fivepocket_generated_paths(FIVEPOCKET_GENERATED_RESOURCES FALSE)
    if(NOT DEFINED FIVEPOCKET_GENERATED_RESOURCE_ROOT)
        set(FIVEPOCKET_GENERATED_RESOURCE_ROOT resources)
    endif()
    file(REAL_PATH "${FIVEPOCKET_GENERATED_RESOURCE_ROOT}" FIVEPOCKET_GENERATED_RESOURCE_ROOT
        BASE_DIRECTORY "${FIVEPOCKET_GAME_DIR}")
    cmake_path(IS_PREFIX FIVEPOCKET_GAME_DIR "${FIVEPOCKET_GENERATED_RESOURCE_ROOT}" NORMALIZE _resource_inside)
    if(NOT _resource_inside)
        message(FATAL_ERROR "Generated resource root must be inside GAME_DIR.")
    endif()
    if(NOT DEFINED FIVEPOCKET_GENERATED_RESOURCE_PREFIX)
        set(FIVEPOCKET_GENERATED_RESOURCE_PREFIX "")
    endif()
    if(IS_ABSOLUTE "${FIVEPOCKET_GENERATED_RESOURCE_PREFIX}" OR FIVEPOCKET_GENERATED_RESOURCE_PREFIX MATCHES "(^|/)[.][.](/|$)")
        message(FATAL_ERROR "Generated resource prefix must be a relative bundle folder.")
    endif()
    foreach(source IN LISTS FIVEPOCKET_GENERATED_SOURCES)
        if(NOT source MATCHES "[.](cpp|cc|cxx|c)$")
            message(FATAL_ERROR "Generated inputs must be source files, not prebuilt objects or libraries: ${source}")
        endif()
    endforeach()
    set(FIVEPOCKET_PAYLOAD_MANIFEST_SHA256 "")
    if(FIVEPOCKET_GENERATED_RESOURCE_PREFIX STREQUAL "payload")
        set(_payload_manifest "${FIVEPOCKET_GENERATED_RESOURCE_ROOT}/manifest.txt")
    else()
        set(_payload_manifest "${FIVEPOCKET_GENERATED_RESOURCE_ROOT}/payload/manifest.txt")
    endif()
    if(EXISTS "${_payload_manifest}")
        file(SHA256 "${_payload_manifest}" FIVEPOCKET_PAYLOAD_MANIFEST_SHA256)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            "${_payload_manifest}")
    endif()
endmacro()
