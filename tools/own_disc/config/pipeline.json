{
 "schema": "own-disc-pipeline/1",
 "id": "fivepocket-duo-source",
 "flavour": "apple",
 "paths": {},
 "min_free_bytes": 21474836480,
 "games": [
  {
   "id": "gta5-x360-disc",
   "label": "GTA V, Xbox 360 disc release without title update (play disc executable)",
   "executable": "default.xex",
   "executable_sha256": "f0ca93fbe6b3dfbf50c026e0d77a71e8294b13a5a775af1b6a64f07b0fc10a3d",
   "executable_size": 26628096,
   "decoded_image_sha256": "0b1c81507f827c29a7dccf5fc58dc23c8142ff4177efe66df21c790a8f65f3b2"
  }
 ],
 "prerequisites": [
  {
   "id": "python",
   "kind": "python",
   "min": "3.9"
  },
  {
   "id": "ndk-clang",
   "kind": "command",
   "argv": [
    "${ndk}/toolchains/llvm/prebuilt/${ndkhost}/bin/clang++${exe}",
    "--version"
   ],
   "match": "clang version 18\\.0\\.3"
  },
  {
   "id": "generator",
   "kind": "file",
   "path": "${hosttools}/XenonRecomp${exe}"
  }
 ],
 "stages": [
  {
   "id": "extract-xex",
   "adapter": "disc-file",
   "disc": "play",
   "path": "default.xex",
   "description": "Copy the game executable out of the play disc.",
   "outputs": {
    "xex": "input/default.xex"
   },
   "expect": {
    "xex": "${game:executable_sha256}"
   }
  },
  {
   "id": "decode-xex",
   "adapter": "command",
   "description": "Decode this run extracted executable using the existing lane-built decoder.",
   "tools": [
    "${hosttools}/xex_image${exe}"
   ],
   "inputs": {
    "xex": "${out:extract-xex:xex}"
   },
   "outputs": {
    "image": "decode/default.image.bin"
   },
   "expect": {
    "image": "${game:decoded_image_sha256}"
   },
   "argv": [
    "${hosttools}/xex_image${exe}",
    "${out:extract-xex:xex}",
    "${work}/decode/default.image.bin"
   ],
   "make_dirs": [
    "decode"
   ]
  },
  {
   "id": "codegen",
   "adapter": "command",
   "heavy": true,
   "description": "Generate from this run extracted executable. Recorded configuration only supplies parameters.",
   "tools": [
    "${repo}/tools/own_disc/regen_check.py",
    "${hosttools}/XenonRecomp${exe}",
    "${repo}/runtime/ppc_context.h",
    "${repo}/tools/own_disc/compile_rehearsal.py"
   ],
   "inputs": {
    "xex": "${out:extract-xex:xex}",
    "config": "${repo}/tools/own_disc/config/recomp.toml",
    "switch_tables": "${repo}/tools/own_disc/config/switch_tables.toml"
   },
   "clean": [
    "codegen"
   ],
   "outputs": {
    "tree": "codegen/ppc",
    "report": "codegen-report.json"
   },
   "argv": [
    "${python}",
    "-B",
    "${repo}/tools/own_disc/compile_rehearsal.py",
    "codegen",
    "--repo",
    "${repo}",
    "--work",
    "${work}",
    "--generator",
    "${hosttools}/XenonRecomp${exe}",
    "--context",
    "${repo}/runtime/ppc_context.h",
    "--config",
    "${repo}/tools/own_disc/config/recomp.toml"
   ]
  },
  {
   "id": "recipe",
   "adapter": "command",
   "description": "Reconstruct all 374 corpus chunks from this run generator plus recorded base passes; stitch this run decoded image; replay recipe v455 and require v507 chunk hashes.",
   "tools": [
    "${repo}/tools/fp_codegen/recipe_build.py",
    "${repo}/tools/fp_codegen/recipe",
    "${repo}/tools/fp_codegen/stitch_split_functions.py",
    "${repo}/tools/own_disc/compile_rehearsal.py",
    "${repo}/tools/fp_codegen/fence_pass.py",
    "${repo}/tools/fp_codegen/recipe/fence_duplicate.py",
    "${repo}/tools/fp_codegen/recipe/anchored_insert.py",
    "${repo}/tools/fp_codegen/recipe/jump_table_repair.py",
    "${repo}/tools/fp_codegen/recipe/gpr_helpers_v243_pass.py",
    "${repo}/tools/fp_codegen/leaf_locals.py",
    "${repo}/tools/fp_codegen/direct_calls.py",
    "${repo}/tools/fp_codegen/gpr_fastpath.py",
    "${repo}/tools/fp_codegen/vmx_all.py",
    "${repo}/tools/fp_codegen/main_code/dcbt_build.py",
    "${repo}/tools/fp_codegen/auto_prefetch/ap_pass.py",
    "${repo}/tools/fp_codegen/render_guest/rg_pass.py",
    "${repo}/tools/fp_codegen/job_code/loop_locals_pass.py",
    "${repo}/tools/fp_codegen/recipe/case_label_flush.py",
    "${repo}/tools/fp_codegen/recipe/case_blocks.py",
    "${repo}/tools/fp_codegen/recipe/switch_expand.py",
    "${repo}/tools/fp_codegen/recipe/error_sites.py",
    "${repo}/tools/fp_codegen/recipe/vmx_unpack_call.py",
    "${repo}/tools/fp_codegen/recipe/vmx_helper_includes.py",
    "${repo}/tools/fp_codegen/recipe/eof_blank.py",
    "${repo}/tools/fp_codegen/recipe/recorded_hunks.py"
   ],
   "inputs": {
    "recipe": "${work}/prepared-recipe.json",
    "generated": "${out:codegen:tree}",
    "image": "${out:decode-xex:image}",
    "param_0_roots": "${repo}/tools/own_disc/config/stitch-roots-v447.json",
    "param_2_records": "${repo}/tools/own_disc/config/fence-dup-v28.json",
    "param_3_records": "${repo}/tools/own_disc/config/xma-diag-v97.json",
    "param_4_records": "${repo}/tools/own_disc/config/jump-tables-v101.json",
    "param_6_targets": "${repo}/tools/own_disc/config/leaf-locals-v349.json",
    "param_7_hooked": "${repo}/tools/own_disc/config/hooked-v393.txt",
    "param_7_chunks": "${repo}/tools/own_disc/config/direct-chunks-v399-v401.json",
    "param_9_exclusions": "${repo}/tools/own_disc/config/manifest.json",
    "param_10_exclusions": "${repo}/tools/own_disc/config/dcbt-build.json",
    "param_11_sites": "${repo}/tools/own_disc/config/ap-sites-v439.json",
    "param_12_sites": "${repo}/tools/own_disc/config/rg-sites-v444.json",
    "param_13_sites": "${repo}/tools/own_disc/config/jc-loop-locals-v452.json",
    "param_14_records": "${repo}/tools/own_disc/config/case-label-flush-v452-pgo.json",
    "param_15_records": "${repo}/tools/own_disc/config/case-blocks.json",
    "param_16_records": "${repo}/tools/own_disc/config/switch-expand.json",
    "param_17_records": "${repo}/tools/own_disc/config/error-sites-published-1.json",
    "param_18_scope": "${repo}/tools/own_disc/config/scope.json",
    "param_19_scope": "${repo}/tools/own_disc/config/scope.json",
    "param_20_scope": "${repo}/tools/own_disc/config/scope.json",
    "param_21_records": "${repo}/tools/own_disc/config/recorded-hunks-published-1.json"
   },
   "outputs": {
    "chunks": "recipe/chunks",
    "corpus": "recipe/corpus",
    "connected_recipe": "recipe/connected-recipe.json",
    "base_check": "recipe/base-check.json"
   },
   "argv": [
    "${python}",
    "-B",
    "${repo}/tools/own_disc/compile_rehearsal.py",
    "recipe",
    "--repo",
    "${repo}",
    "--work",
    "${work}",
    "--recipe",
    "${work}/prepared-recipe.json"
   ],
   "heavy": true,
   "clean": [
    "recipe"
   ]
  },
  {
   "id": "shader-extract",
   "adapter": "command",
   "heavy": false,
   "description": "Read both disc filesystems, recurse game RPFs and install packages, recover RPF secret only in memory from this run codegen, and inventory all FXCs; unknown classes remain explicit.",
   "tools": [
    "${python}",
    "${repo}/tools/own_disc/build_shader_pack.py",
    "${repo}/tools/own_disc/disc_builder.py",
    "${repo}/tools/host_guest_trace/stfs_inventory.py",
    "${repo}/tools/rpf7_inventory",
    "${repo}/tools/iter/generic_shader_pack.py",
    "${hosttools}/xmem-lzx${exe}"
   ],
   "inputs": {
    "generated": "${out:codegen:tree}"
   },
   "outputs": {
    "inventory": "shader-extract/inventory.json",
    "containers": "shader-extract/containers",
    "effects": "shader-extract/fxc",
    "packages": "shader-extract/packages"
   },
   "clean": [
    "shader-extract"
   ],
   "argv": [
    "${python}",
    "${repo}/tools/own_disc/build_shader_pack.py",
    "--repo",
    "${repo}",
    "extract",
    "--play",
    "${disc:play}",
    "--install",
    "${disc:install}",
    "--generated",
    "${out:codegen:tree}",
    "--xmem",
    "${hosttools}/xmem-lzx${exe}",
    "--key-address",
    "0x83bd4c98",
    "--title-id",
    "0x545408a7",
    "--output",
    "${work}/shader-extract"
   ]
  },
  {
   "id": "shader-pack",
   "adapter": "command",
   "heavy": true,
   "description": "Translate every bounded disc container with the declared XenosRecomp, descriptor32 DXC flags and spirv-val, then production GSP2 packer. Refuses completion on deferred sources or failed translations; no supplied shader records.",
   "tools": [
    "${python}",
    "${repo}/tools/own_disc/build_shader_pack.py",
    "${repo}/tools/own_disc/disc_builder.py",
    "${repo}/tools/rpf7_inventory",
    "${repo}/tools/iter/generic_shader_pack.py",
    "${hosttools}/xenos/main/XenosRecomp${exe}",
    "${hosttools}/xenos/main/XenosShaderPreflight${exe}",
    "${hosttools}/xenos/main/shader_common.h",
    "${hosttools}/dxc/bin/dxc-3.7${exe}",
    "${ndk}/shader-tools/${ndkhost}/spirv-val${exe}",
    "${hosttools}/dxc/lib",
    "${repo}/tools/own_disc/shader_toolchain.py"
   ],
   "inputs": {
    "inventory": "${out:shader-extract:inventory}",
    "containers": "${out:shader-extract:containers}"
   },
   "outputs": {
    "pack": "shader-translation/generic-shaders.bin",
    "report": "shader-translation/translation.json",
    "records": "shader-translation"
   },
   "clean": [
    "shader-translation"
   ],
   "argv": [
    "${python}",
    "${repo}/tools/own_disc/build_shader_pack.py",
    "--repo",
    "${repo}",
    "translate",
    "--inventory",
    "${work}/shader-extract",
    "--host-tools",
    "${hosttools}",
    "--ndk",
    "${ndk}",
    "--output",
    "${work}/shader-translation",
    "--jobs",
    "4",
    "--unresolved-ok"
   ]
  },
  {
   "id": "shader-select",
   "adapter": "command",
   "description": "The pack v507 is pinned to: the listed runtime keys out of the full translation, by the production packer.",
   "tools": [
    "${python}",
    "${repo}/tools/own_disc/build_shader_pack.py",
    "${repo}/tools/iter/generic_shader_pack.py",
    "${repo}/tools/own_disc/disc_builder.py"
   ],
   "inputs": {
    "translation": "${out:shader-pack:report}",
    "records": "${out:shader-pack:records}",
    "keys": "${repo}/tools/own_disc/config/gta5-v507-shader-keys.json"
   },
   "outputs": {
    "pack": "shader-select/generic-shaders.bin",
