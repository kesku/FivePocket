   },
   "expect": {
    "pack": "17fc51a8b382fa84904e10ad8e86c9bdb7d98a90866f5e1c7851abcf11f93fa2"
   },
   "clean": [
    "shader-select"
   ],
   "argv": [
    "${python}",
    "${repo}/tools/own_disc/build_shader_pack.py",
    "--repo",
    "${repo}",
    "select",
    "--translation",
    "${work}/shader-translation",
    "--keys",
    "${repo}/tools/own_disc/config/gta5-v507-shader-keys.json",
    "--output",
    "${work}/shader-select",
    "--expect-sha256",
    "17fc51a8b382fa84904e10ad8e86c9bdb7d98a90866f5e1c7851abcf11f93fa2"
   ]
  },
  {
   "id": "shader-overrides",
   "adapter": "command",
   "heavy": true,
   "description": "Generate private v507 override headers and container swizzles from this run disc records; original baseline and repair-delta controls, DXC and validator required.",
   "tools": [
    "${python}",
    "${repo}/tools/own_disc/build_shader_pack.py",
    "${repo}/tools/own_disc/disc_builder.py",
    "${repo}/tools/iter/generic_shader_pack.py",
    "${repo}/tools/own_disc/build_shader_extras.py",
    "${repo}/tools/own_disc/shader_override_rules.py",
    "${hosttools}/xenos/main/XenosRecomp${exe}",
    "${hosttools}/xenos/main/XenosShaderPreflight${exe}",
    "${hosttools}/xenos/main/shader_common.h",
    "${hosttools}/dxc/bin/dxc-3.7${exe}",
    "${ndk}/shader-tools/${ndkhost}/spirv-val${exe}",
