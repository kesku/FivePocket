#!/bin/sh
# The FivePocket builder on macOS (2026-11-05): runs the front end (tools/own_disc/builder.py) with the Python of the Mac's Xcode
# (Python 3.9: python-compat/ adds what the tools use from 3.10), this folder as the package, its host programs, and Xcode from
# DEVELOPER_DIR (default /Applications/Xcode.app when it is there). Usage: ./builder [check|fetch|build|sign] ...
# Without a word it prints what to do. Nothing here installs anything.
here=$(cd "$(dirname "$0")" && pwd -P) || exit 2
export BUILDER_PACKAGE_ROOT="$here"
export BUILDER_HOST_TOOLS="$here/host-tools"
export PYTHONPATH="$here/tools/own_disc/macos/python-compat${PYTHONPATH:+:$PYTHONPATH}"
if [ -z "$DEVELOPER_DIR" ] && [ -d /Applications/Xcode.app/Contents/Developer ]; then
  export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
fi
python=${BUILDER_PYTHON:-/usr/bin/python3}
exec "$python" -B "$here/tools/own_disc/builder.py" "$@"
