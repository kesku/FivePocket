diff --git a/XenosRecomp/shader_container_scan.h b/XenosRecomp/shader_container_scan.h
new file mode 100644
index 0000000..06792ed
--- /dev/null
+++ b/XenosRecomp/shader_container_scan.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+inline constexpr size_t XENOS_SHADER_CONTAINER_HEADER_SIZE = 36;
+inline constexpr uint32_t XENOS_SHADER_CONTAINER_FLAGS_MASK = 0xFFFFFF00;
+inline constexpr uint32_t XENOS_SHADER_CONTAINER_FLAGS_MAGIC = 0x102A1100;
+
+inline uint32_t ReadXenosBigEndian32(const uint8_t* data)
+{
+    return (uint32_t(data[0]) << 24) |
+        (uint32_t(data[1]) << 16) |
+        (uint32_t(data[2]) << 8) |
+        uint32_t(data[3]);
+}
+
+inline bool TryGetXenosShaderContainerSize(
+    const uint8_t* data,
+    size_t availableSize,
+    size_t& containerSize)
+{
+    containerSize = 0;
+    if (data == nullptr || availableSize < XENOS_SHADER_CONTAINER_HEADER_SIZE)
+        return false;
+
+    const uint32_t flags = ReadXenosBigEndian32(data);
+    if ((flags & XENOS_SHADER_CONTAINER_FLAGS_MASK) != XENOS_SHADER_CONTAINER_FLAGS_MAGIC)
+        return false;
+
+    const uint32_t virtualSize = ReadXenosBigEndian32(data + 4);
+    const uint32_t physicalSize = ReadXenosBigEndian32(data + 8);
+    if (physicalSize > std::numeric_limits<uint32_t>::max() - virtualSize)
+        return false;
+
+    const uint32_t combinedSize = virtualSize + physicalSize;
+    if (combinedSize < XENOS_SHADER_CONTAINER_HEADER_SIZE || combinedSize > availableSize)
+        return false;
+
+    if (ReadXenosBigEndian32(data + 28) != 0 || ReadXenosBigEndian32(data + 32) != 0)
+        return false;
+
+    containerSize = combinedSize;
+    return true;
+}
