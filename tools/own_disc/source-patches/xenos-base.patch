diff --git a/XenosTests/shader_container_scan_test.cpp b/XenosTests/shader_container_scan_test.cpp
new file mode 100644
index 0000000..8008066
--- /dev/null
+++ b/XenosTests/shader_container_scan_test.cpp
@@ -0,0 +1,83 @@
+#include "shader_container_scan.h"
+
+#include <array>
+#include <cstdlib>
+#include <iostream>
+#include <limits>
+
+namespace
+{
+void WriteBigEndian32(uint8_t* output, uint32_t value)
+{
+    output[0] = uint8_t(value >> 24);
+    output[1] = uint8_t(value >> 16);
+    output[2] = uint8_t(value >> 8);
+    output[3] = uint8_t(value);
+}
+
+std::array<uint8_t, 64> ValidContainer()
+{
+    std::array<uint8_t, 64> data{};
+    WriteBigEndian32(data.data(), XENOS_SHADER_CONTAINER_FLAGS_MAGIC | 1);
+    WriteBigEndian32(data.data() + 4, 48);
+    WriteBigEndian32(data.data() + 8, 16);
+    return data;
+}
+
+void Require(bool condition, const char* message)
+{
+    if (!condition)
+    {
+        std::cerr << message << '\n';
+        std::exit(1);
+    }
+}
+}
+
+int main()
+{
+    size_t size = 123;
+    auto valid = ValidContainer();
+    Require(
+        TryGetXenosShaderContainerSize(valid.data(), valid.size(), size) && size == valid.size(),
+        "exact bounded container was rejected");
+
+    Require(
+        !TryGetXenosShaderContainerSize(valid.data(), 35, size) && size == 0,
+        "truncated header was accepted");
+
+    auto wrongMagic = valid;
+    wrongMagic[0] = 0;
+    Require(
+        !TryGetXenosShaderContainerSize(wrongMagic.data(), wrongMagic.size(), size),
+        "wrong magic was accepted");
+
+    auto zeroSize = valid;
+    WriteBigEndian32(zeroSize.data() + 4, 0);
+    WriteBigEndian32(zeroSize.data() + 8, 0);
+    Require(
+        !TryGetXenosShaderContainerSize(zeroSize.data(), zeroSize.size(), size),
+        "zero-size candidate was accepted");
+
+    auto overflow = valid;
+    WriteBigEndian32(overflow.data() + 4, std::numeric_limits<uint32_t>::max());
+    WriteBigEndian32(overflow.data() + 8, 1);
+    Require(
+        !TryGetXenosShaderContainerSize(overflow.data(), overflow.size(), size),
+        "uint32 size overflow was accepted");
+
+    auto outsideInput = valid;
+    WriteBigEndian32(outsideInput.data() + 4, 64);
+    WriteBigEndian32(outsideInput.data() + 8, 4);
+    Require(
+        !TryGetXenosShaderContainerSize(outsideInput.data(), outsideInput.size(), size),
+        "container extent outside input was accepted");
+
+    auto reserved = valid;
+    WriteBigEndian32(reserved.data() + 28, 1);
+    Require(
+        !TryGetXenosShaderContainerSize(reserved.data(), reserved.size(), size),
+        "nonzero reserved field was accepted");
+
+    return 0;
+}
diff --git a/XenosTests/shader_validator_batch_test.cpp b/XenosTests/shader_validator_batch_test.cpp
new file mode 100644
index 0000000..dee3266
--- /dev/null
+++ b/XenosTests/shader_validator_batch_test.cpp
@@ -0,0 +1,101 @@
+#include "shader_container_scan.h"
+#include "shader_validator_batch.h"
+
+#include <cstdlib>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace
+{
+void WriteBigEndian16(uint8_t* output, uint16_t value)
+{
+    output[0] = uint8_t(value >> 8);
+    output[1] = uint8_t(value);
+}
+
+void WriteBigEndian32(uint8_t* output, uint32_t value)
+{
+    output[0] = uint8_t(value >> 24);
+    output[1] = uint8_t(value >> 16);
+    output[2] = uint8_t(value >> 8);
+    output[3] = uint8_t(value);
+}
+
+std::vector<uint8_t> ValidPixelContainer()
+{
+    constexpr uint32_t virtualSize = 160;
+    constexpr uint32_t physicalSize = 12;
+    std::vector<uint8_t> data(virtualSize + physicalSize);
+    WriteBigEndian32(data.data(), XENOS_SHADER_CONTAINER_FLAGS_MAGIC);
+    WriteBigEndian32(data.data() + 4, virtualSize);
+    WriteBigEndian32(data.data() + 8, physicalSize);
+    WriteBigEndian32(data.data() + 16, 36);
+    WriteBigEndian32(data.data() + 20, 128);
+    WriteBigEndian32(data.data() + 24, 96);
+    WriteBigEndian32(data.data() + 36, 56);
+    WriteBigEndian32(data.data() + 40, 28);
+    WriteBigEndian32(data.data() + 52, 1);
+    WriteBigEndian32(data.data() + 56, 28);
+    WriteBigEndian32(data.data() + 68, 48);
+    WriteBigEndian16(data.data() + 72, 2);
+    WriteBigEndian16(data.data() + 76, 1);
+    data[88] = 'c';
+    data[89] = '0';
+    WriteBigEndian32(data.data() + 100, 12);
+    // Definition table size: the bytes after its 20-byte header (records and the float,
+    // integer and boolean terminators): 12 for an empty table.
+    WriteBigEndian32(data.data() + 144, 12);
+    return data;
+}
+
+void AppendFrame(std::string& stream, const std::vector<uint8_t>& payload)
+{
+    const size_t offset = stream.size();
+    stream.resize(offset + 4);
+    WriteBigEndian32(reinterpret_cast<uint8_t*>(stream.data() + offset), uint32_t(payload.size()));
+    stream.append(reinterpret_cast<const char*>(payload.data()), payload.size());
+}
+
+void Require(bool condition, const char* message)
+{
+    if (!condition)
+    {
+        std::cerr << message << '\n';
+        std::exit(1);
+    }
+}
+}
+
+int main()
+{
+    const auto valid = ValidPixelContainer();
+    auto invalid = valid;
+    invalid.resize(invalid.size() - 1);
+
+    std::string framed;
+    AppendFrame(framed, valid);
+    AppendFrame(framed, invalid);
+    framed.append(4, '\0');
+    std::istringstream input(framed);
+    XenosShaderBatchSummary summary;
+    Require(
+        ValidateXenosShaderBatch(input, summary) == XenosShaderBatchResult::Invalid,
+        "mixed batch did not report invalid");
+    Require(summary.submitted == 2 && summary.valid == 1 && summary.invalid == 1,
+        "mixed batch totals are wrong");
+
+    std::istringstream truncated(framed.substr(0, framed.size() - 3));
+    Require(
+        ValidateXenosShaderBatch(truncated, summary) == XenosShaderBatchResult::ProtocolError,
+        "truncated framing was accepted");
+
+    std::string trailing(4, '\0');
+    trailing.push_back('x');
+    std::istringstream trailingInput(trailing);
+    Require(
+        ValidateXenosShaderBatch(trailingInput, summary) == XenosShaderBatchResult::ProtocolError,
+        "bytes after the terminator were accepted");
+    return 0;
+}
diff --git a/XenosTests/shader_validator_test.cpp b/XenosTests/shader_validator_test.cpp
new file mode 100644
index 0000000..7252289
--- /dev/null
+++ b/XenosTests/shader_validator_test.cpp
@@ -0,0 +1,221 @@
+#include "shader_container_scan.h"
+#include "shader_validator.h"
+
+#include <cstdlib>
+#include <iostream>
+#include <string>
+#include <vector>
+
+namespace
+{
+void WriteBigEndian16(uint8_t* output, uint16_t value)
+{
+    output[0] = uint8_t(value >> 8);
+    output[1] = uint8_t(value);
+}
+
+void WriteBigEndian32(uint8_t* output, uint32_t value)
+{
+    output[0] = uint8_t(value >> 24);
+    output[1] = uint8_t(value >> 16);
+    output[2] = uint8_t(value >> 8);
+    output[3] = uint8_t(value);
+}
+
+std::vector<uint8_t> ValidPixelContainer()
+{
+    constexpr uint32_t virtualSize = 160;
+    constexpr uint32_t physicalSize = 12;
+    std::vector<uint8_t> data(virtualSize + physicalSize);
+    WriteBigEndian32(data.data(), XENOS_SHADER_CONTAINER_FLAGS_MAGIC);
+    WriteBigEndian32(data.data() + 4, virtualSize);
+    WriteBigEndian32(data.data() + 8, physicalSize);
+    WriteBigEndian32(data.data() + 16, 36);
+    WriteBigEndian32(data.data() + 20, 128);
+    WriteBigEndian32(data.data() + 24, 96);
+
+    WriteBigEndian32(data.data() + 36, 56);
+    WriteBigEndian32(data.data() + 40, 28);
+    WriteBigEndian32(data.data() + 52, 1);
+    WriteBigEndian32(data.data() + 56, 28);
+    WriteBigEndian32(data.data() + 68, 48);
+    WriteBigEndian16(data.data() + 72, 2);
+    WriteBigEndian16(data.data() + 74, 0);
+    WriteBigEndian16(data.data() + 76, 1);
+    data[88] = 'c';
+    data[89] = '0';
+
+    WriteBigEndian32(data.data() + 100, 12);
+
+    // Definition table size: the bytes after its 20-byte header (records and the float,
+    // integer and boolean terminators): 12 for an empty table.
+    WriteBigEndian32(data.data() + 144, 12);
+    return data;
+}
+
+void Require(bool condition, const char* message)
+{
+    if (!condition)
+    {
+        std::cerr << message << '\n';
+        std::exit(1);
+    }
+}
+
+void RequireRejected(std::vector<uint8_t> data, const char* expected, const char* message)
+{
+    std::string error;
+    Require(!ValidateXenosShaderContainer(data.data(), data.size(), error), message);
+    Require(error.find(expected) != std::string::npos, "validator returned the wrong error");
+}
+}
+
+int main()
+{
+    std::string error;
+    auto valid = ValidPixelContainer();
+    Require(
+        ValidateXenosShaderContainer(valid.data(), valid.size(), error),
+        "valid bounded pixel container was rejected");
+
+    // Pixel shaders address all 256 float4 constants (GTA V reads c254/c255).
+    auto lastPixelConstant = valid;
+    WriteBigEndian16(lastPixelConstant.data() + 74, 255);
+    Require(ValidateXenosShaderContainer(lastPixelConstant.data(), lastPixelConstant.size(), error),
+        "pixel constant c255 was rejected");
+    auto pastPixelConstants = valid;
+    WriteBigEndian16(pastPixelConstants.data() + 74, 250);
+    WriteBigEndian16(pastPixelConstants.data() + 76, 7);
+    RequireRejected(std::move(pastPixelConstants), "float constant register range", "pixel constants past c255 accepted");
+
+    auto constantBounds = valid;
+    WriteBigEndian32(constantBounds.data() + 16, 156);
+    RequireRejected(std::move(constantBounds), "constant table header", "bad constant offset accepted");
+
+    auto constantCount = valid;
+    WriteBigEndian32(constantCount.data() + 52, 5000);
+    RequireRejected(std::move(constantCount), "constant count", "huge constant count accepted");
+
+    auto unalignedConstantInfo = valid;
+    WriteBigEndian32(unalignedConstantInfo.data() + 56, 29);
+    RequireRejected(
+        std::move(unalignedConstantInfo),
+        "constant-info array",
+        "unaligned constant-info array accepted");
+
+    auto unterminatedName = valid;
+    for (size_t i = 88; i < 96; ++i)
+        unterminatedName[i] = 'x';
+    RequireRejected(std::move(unterminatedName), "constant name", "unterminated name accepted");
+
+    for (uint32_t value = 0; value < 256; ++value)
+    {
+        auto name = valid;
+        name[88] = uint8_t(value);
+        const bool letter = (value >= 'A' && value <= 'Z') ||
+            (value >= 'a' && value <= 'z') || value == '_';
+        Require(ValidateXenosShaderContainer(name.data(), name.size(), error) == letter,
+            "constant identifier first-byte policy mismatch");
+        name = valid;
+        name[89] = uint8_t(value);
+        const bool digit = value >= '0' && value <= '9';
+        Require(ValidateXenosShaderContainer(name.data(), name.size(), error) ==
+                (value == 0 || letter || digit),
+            "constant identifier continuation-byte policy mismatch");
+    }
+    auto directive = valid;
+    directive[89] = '\n';
+    RequireRejected(std::move(directive), "constant name", "directive injection accepted");
+
+    auto pixelArray = valid;
+    WriteBigEndian32(pixelArray.data() + 20, 0);
+    WriteBigEndian32(pixelArray.data() + 24, 128);
+    WriteBigEndian32(pixelArray.data() + 148, 1 << 5);
+    RequireRejected(std::move(pixelArray), "pixel interpolator", "truncated pixel array accepted");
+
+    auto invalidUsage = valid;
+    WriteBigEndian32(invalidUsage.data() + 20, 0);
+    WriteBigEndian32(invalidUsage.data() + 116, 1 << 5);
+    WriteBigEndian32(invalidUsage.data() + 128, 14 << 4);
+    RequireRejected(std::move(invalidUsage), "declaration usage", "invalid interpolator usage accepted");
+
+    auto vertexArray = valid;
+    WriteBigEndian32(vertexArray.data(), XENOS_SHADER_CONTAINER_FLAGS_MAGIC | 1);
+    WriteBigEndian32(vertexArray.data() + 120, 100);
+    WriteBigEndian32(vertexArray.data() + 124, 1);
+    RequireRejected(std::move(vertexArray), "vertex declaration", "bad vertex declaration accepted");
+
+    auto missingDefinitionTerminator = valid;
+    missingDefinitionTerminator.resize(168);
+    WriteBigEndian32(missingDefinitionTerminator.data() + 4, 156);
+    WriteBigEndian32(missingDefinitionTerminator.data() + 8, 12);
+    WriteBigEndian32(missingDefinitionTerminator.data() + 148, 1 << 16);
+    WriteBigEndian32(missingDefinitionTerminator.data() + 152, 0);
+    RequireRejected(
+        std::move(missingDefinitionTerminator),
+        "terminator",
+        "missing definition terminator accepted");
+
+    auto definitionPhysical = valid;
+    WriteBigEndian32(definitionPhysical.data() + 148, 4);
+    WriteBigEndian32(definitionPhysical.data() + 152, 64);
+    RequireRejected(std::move(definitionPhysical), "physical data", "bad definition values accepted");
+
+    auto integerDefinition = valid;
+    WriteBigEndian32(integerDefinition.data() + 152, 4);
+    RequireRejected(
+        std::move(integerDefinition),
+        "integer definition values",
+        "truncated integer definition values accepted");
+
+    // A float record and a loop-constant record (GTA V's steep-parallax pixel shaders): the
+    // table grows by 16 bytes past the empty form and its size field reads 28.
+    {
+        std::vector<uint8_t> loop(valid.begin(), valid.begin() + 160); // virtual part
+        loop.resize(176);
+        WriteBigEndian32(loop.data() + 4, 176);         // virtual size
+        WriteBigEndian32(loop.data() + 8, 16);          // physical size
+        WriteBigEndian32(loop.data() + 144, 28);
+        WriteBigEndian32(loop.data() + 148, 0x01F40004); // c500 (pixel c244), 4 values
+        WriteBigEndian32(loop.data() + 152, 0);          // at physical offset 0
+        WriteBigEndian32(loop.data() + 156, 0);          // float terminator
+        WriteBigEndian32(loop.data() + 160, 0x239C0001); // i31, one value
+        WriteBigEndian32(loop.data() + 164, 8);
+        WriteBigEndian32(loop.data() + 168, 0);          // integer terminator
+        WriteBigEndian32(loop.data() + 172, 0);          // boolean terminator
+        loop.insert(loop.end(), valid.begin() + 160, valid.end()); // the instruction
+        loop.resize(176 + 16);
+        Require(ValidateXenosShaderContainer(loop.data(), loop.size(), error),
+            "float and integer definition table (size 28) was rejected");
+        auto mismatch = loop;
+        WriteBigEndian32(mismatch.data() + 144, 20);
+        RequireRejected(std::move(mismatch), "definition table size", "definition size mismatch accepted");
+    }
+
+    auto codeSize = valid;
+    WriteBigEndian32(codeSize.data() + 100, 11);
+    RequireRejected(std::move(codeSize), "multiple of 12", "partial instruction accepted");
+
+    auto codeExtent = valid;
+    WriteBigEndian32(codeExtent.data() + 96, 8);
+    RequireRejected(std::move(codeExtent), "microcode", "physical code overrun accepted");
+
+    auto controlFlowExtent = valid;
+    WriteBigEndian32(controlFlowExtent.data() + 160, 10 | (1 << 12));
+    WriteBigEndian32(controlFlowExtent.data() + 164, 0x1000);
+    RequireRejected(
+        std::move(controlFlowExtent),
+        "control-flow execution range",
+        "out-of-range control-flow reference accepted");
+
+    auto missingVertexDeclaration = valid;
+    WriteBigEndian32(missingVertexDeclaration.data(), XENOS_SHADER_CONTAINER_FLAGS_MAGIC | 1);
+    WriteBigEndian32(missingVertexDeclaration.data() + 160, (1 << 12) | (1 << 16));
+    WriteBigEndian32(missingVertexDeclaration.data() + 164, 0x1000);
+    RequireRejected(
+        std::move(missingVertexDeclaration),
+        "vertex fetch",
+        "vertex fetch without a declaration accepted");
+
+    return 0;
+}
